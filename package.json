{
  "name": "zzy-robinhood-agent",
  "version": "0.4.0",
  "private": true,
  "description": "ZZY: on-chain agent on Robinhood Chain. Claims $ZZY creator fees from pons, buys and permanently holds $ZZY with half, trades Robinhood Stock Tokens via Uniswap with the other half.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "release:check": "node src/index.mjs release:check",
    "catalog": "node src/index.mjs catalog",
    "catalog:refresh": "node src/index.mjs catalog refresh",
    "verify": "node src/index.mjs verify",
    "verify:write": "node src/index.mjs verify --write",
    "social:preview": "node src/index.mjs social:preview",
    "social:hello": "node src/index.mjs social:hello",
    "social:log": "node src/index.mjs social:log",
    "quote": "node src/index.mjs quote",
    "wallet": "node src/index.mjs wallet",
    "wallet:new": "node src/index.mjs wallet new",
    "fund": "node src/index.mjs fund",
    "buy": "node src/index.mjs buy",
    "smoke:testnet": "node src/index.mjs smoke",
    "fork": "anvil --fork-url https://rpc.mainnet.chain.robinhood.com --chain-id 4663",
    "fork:setup": "node src/index.mjs fork setup",
    "fork:status": "node src/index.mjs fork",
    "fork:buy": "node src/index.mjs fork:buy",
    "fork:sell": "node src/index.mjs fork:sell",
    "preflight": "node src/index.mjs preflight",
    "paper": "node src/index.mjs paper",
    "paper:reset": "node src/index.mjs paper reset",
    "tick:paper": "node src/index.mjs tick --paper",
    "run:paper": "node src/index.mjs run --paper",
    "control": "node src/index.mjs control",
    "control:paper": "node src/index.mjs control --paper",
    "control:fork": "node src/index.mjs control --fork",
    "zzy": "node src/index.mjs zzy",
    "treasury": "node src/index.mjs treasury",
    "treasury:plan": "node src/index.mjs treasury plan",
    "site": "node src/index.mjs site",
    "site:serve": "node src/index.mjs site serve",
    "site:push": "node src/index.mjs site:push",
    "site:deploy": "cd site && vercel --prod --yes",
    "tick": "node src/index.mjs tick",
    "run": "node src/index.mjs run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "viem": "^2.56.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB/zzy"
  }
}
