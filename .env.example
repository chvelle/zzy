# Copy to `.env` (gitignored). Never commit real values.

# Optional LLM layers (research.mjs / llm-decision.mjs). Only needed if enabled in config.
ANTHROPIC_API_KEY=

# SEC fair-access policy requires a User-Agent with app name + contact email.
# Set config.news.edgarUserAgent to e.g. "zzy-agent you@example.com"

# ---- LIVE EXECUTION ONLY -----------------------------------------------------
# Leave both blank for preview mode (the default). Preview reads chain state and
# logs what it WOULD do; it cannot sign.
#
# ZZY_OPERATOR_PRIVATE_KEY: a DEDICATED operator wallet. This must be the wallet
# that is the $ZZY creator fee payout recipient (see `npm run zzy`), and it
# should hold nothing you can't afford to lose to a bug. Never your main wallet.
ZZY_OPERATOR_PRIVATE_KEY=
#
# Exact phrase required, in addition to config.mode = "live":
# ZZY_LIVE_EXECUTION_ACK=I_UNDERSTAND_THIS_SIGNS_TRANSACTIONS_WITH_REAL_FUNDS
ZZY_LIVE_EXECUTION_ACK=

# ── X (Twitter) posting for ZZY's own account ────────────────────────
# From developer.x.com: create an app, set permissions to Read and Write,
# then generate the four values below. The access token must be generated
# AFTER setting Read and Write, or it will be read-only.
# Leave blank to keep social in dry-run: posts are logged, nothing leaves.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Live site feed (Vercel Blob) ────────────────────────────────────
# Vercel dashboard: Storage, Create Database, Blob, connect it to the zzy
# project. Then Settings, Environment Variables: copy BLOB_READ_WRITE_TOKEN.
# With this set, the bot pushes data.json and history.json to the blob as
# they change and zzy.live updates on its own.
BLOB_READ_WRITE_TOKEN=
